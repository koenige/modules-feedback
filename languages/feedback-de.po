# ---  HTML: successful responses
#: templates/feedback.template.txt:13
msgid "Thank you for your message."
msgstr "Vielen Dank für Ihre Nachricht."

#: templates/feedback.template.txt:14
msgid "Send another message"
msgstr "Eine weitere Nachricht senden"

# ---  HTML: error responses
#: templates/feedback.template.txt:19
msgid ""
"A temporary problem has occured. We have not been able to send your message "
"yet."
msgstr ""
"Wir konnten Ihre Nachricht aufgrund eines vorübergehenden Problems leider "
"noch nicht versenden."

#: templates/feedback.template.txt:20
msgid "Please try again soon."
msgstr "Bitte versuchen Sie es erneut."

#: templates/feedback.template.txt:23 templates/feedback.template.txt:27
msgid ""
"Your message looks like bulk mail. We do not accept bulk mail via this form."
msgstr ""
"Ihre Nachricht sieht aus wie eine Massenmail. Wir möchten über dieses "
"Formular keine Massenmails bekommen."

#: templates/feedback.template.txt:24
msgid "Please write more than one word."
msgstr "Bitte schreiben Sie mehr als ein Wort."

#: templates/feedback.template.txt:28
msgid "Please do not use HTML or BBCode formatting!"
msgstr "Bitte benutzen Sie zur Formatierung kein HTML oder BBCode!"

#: templates/feedback.template.txt:29 templates/feedback.template.txt:33
#: templates/feedback.template.txt:37
msgid "Please complete the form."
msgstr "Bitte füllen Sie das Formular vollständig aus."

#: templates/feedback.template.txt:32
msgid ""
"Please use simple links instead of URL shorteners so we know what we are "
"clicking on."
msgstr ""
"Bitte verwenden Sie einfache Links anstelle von URL-Verkürzungen, damit wir "
"wissen, worauf wir klicken."

#: templates/feedback.template.txt:36
msgid "We still need some information from you."
msgstr "Wir benötigen von Ihnen noch weitere Informationen."

#: templates/feedback.template.txt:39
msgid "The e-mail address is incorrect."
msgstr "Die E-Mail-Adresse ist fehlerhaft."

